digraph G {
 graph [fontname="DejaVu Sans", fontsize=20, labelloc=t, bgcolor="white", pad=0.35, nodesep=0.45, ranksep=0.65];
 node [shape=box, style="rounded,filled", fillcolor="#eef5ff", color="#365b80", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
 edge [fontname="DejaVu Sans", fontsize=10, color="#425466", arrowsize=0.8];

 graph [rankdir=TB, label="dimc_datapath — RTL architecture"];
 command [label="Controller ports\nstart + matrix dimensions + configuration"];
 sources [label="Streamer ports\ninput_i / kernel_i\n256-bit data + valid / ready"];
 receiver [label="Result receiver\nresult_o[0:31][0:7] (256 x 32 bits)\nresult_k_o / result_q_o\nresult_valid_o / result_ready_i"];
 subgraph cluster_dp {
 label="dimc_datapath"; color="#94a3b8";
 ctrl [label="Sequencer\nState flip-flops + counters + configuration registers\nComparators, next-value muxes, control decode\nSee control-logic diagram", fillcolor="#dbeafe"];
 subgraph cluster_cleo {
 label="i_cleopatra"; color="#94a3b8";
 subgraph cluster_dual {
 label="u_dimc_dual"; color="#b4c1ce";
 fi [label="Input FIFO\n32 x 256 bits (default)", fillcolor="#e0e7ff"];
 fw [label="Weight FIFO\n128 x 256 bits (default)", fillcolor="#e0e7ff"];
 m0 [label="DIMC macro 0\nWeight memory: 32 x 1024 bits\nFeature registers: 4 x 256 bits\nPipelined dot-product arithmetic"];
 m1 [label="DIMC macro 1\nWeight memory: 32 x 1024 bits\nFeature registers: 4 x 256 bits\nPipelined dot-product arithmetic"];
 mux [shape=diamond, label="Output mux\nsel = active_q", fillcolor="#fff1cf"];
 fo [label="Output FIFO\n64 x 32 bits (default)", fillcolor="#e0e7ff"];
 fi -> m0 [label="FD, 256 bits"];
 fi -> m1 [label="FD (shared bus)"];
 fw -> m0 [label="D, 256 bits"];
 fw -> m1 [label="D (shared bus)"];
 m0 -> mux [label="PSOUT + READYN"];
 m1 -> mux [label="PSOUT + READYN"];
 mux -> fo [label="push when !READYN && !out_full"];
 }
 selector [label="cleopatra_ctrl\n8-bit index register + incrementer\n1-of-256 enable decoder", fillcolor="#dbeafe"];
 acc [label="256 accumulators\nEach: 32-bit adder + feedback mux + 32-bit register\nClear priority, otherwise add only when enabled", fillcolor="#dbeafe"];
 fo -> acc [label="out_data (32 bits, broadcast)"];
 fo -> selector [label="out_pop = !out_empty"];
 selector -> acc [label="enable[i] = out_pop && acc_sel[i]"];
 acc -> acc [label="stored sum feedback"];
 }
 wiring [label="Fixed output wiring (no extra storage)\nresult_o[r][c] = acc[c*32+r]", fillcolor="#fff1cf"];
 acc -> wiring [label="256 x 32-bit sums"];
 ctrl -> m0 [style=dashed, label="macro 0 controls + config"];
 ctrl -> m1 [style=dashed, label="macro 1 controls + config"];
 ctrl -> mux [style=dashed, label="active_q"];
 ctrl -> selector [style=dashed, label="acc_clear"];
 ctrl -> acc [style=dashed, label="acc_clear"];
 fi -> ctrl [style=dashed, label="full / empty", constraint=false];
 fw -> ctrl [style=dashed, label="full / empty", constraint=false];
 fo -> ctrl [style=dashed, label="result_pop", constraint=false];
 }
 command -> ctrl;
 sources -> fi [label="inp_push + input data"];
 sources -> fw [label="wgt_push + weight data"];
 ctrl -> sources [style=dashed, label="per-stream ready", constraint=false];
 wiring -> receiver;
 ctrl -> receiver [style=dashed, label="valid + tile coordinates"];
 receiver -> ctrl [style=dashed, label="result_ready_i", constraint=false];
 clock [shape=note, fillcolor="#f1f5f9", label="clk_i clocks all sequential blocks.\ncore_rst_n = rst_ni AND NOT clear_i resets them.\nSolid: data/events. Dashed: control/status.\nStorage sizes are RTL defaults, not synthesized cell counts."];

}
