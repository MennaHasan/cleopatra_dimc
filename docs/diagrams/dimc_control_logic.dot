digraph G {
 graph [fontname="DejaVu Sans", fontsize=20, labelloc=t, bgcolor="white", pad=0.35, nodesep=0.45, ranksep=0.65];
 node [shape=box, style="rounded,filled", fillcolor="#eef5ff", color="#365b80", fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12"];
 edge [fontname="DejaVu Sans", fontsize=10, color="#425466", arrowsize=0.8];

 graph [rankdir=LR, label="Datapath control — flip-flops and combinational digital logic"];
 ext [label="External inputs\nstart_i / dimensions / config\nstream valid / result_ready_i\nFIFO full/empty / result_pop"];
 subgraph cluster_comb {
 label="Combinational logic (no storage)"; color="#d9ab4c";
 cond [label="Comparators + AND / OR / NOT gates\nvalid_config: size/mode checks\nhas_next: k/l/q vs final indices\nnext_loaded: counts == 128,32,4\nphase_complete: DRAIN && results==256\n                       && (!has_next || next_loaded)", fillcolor="#fff1cf"];
 update [label="Register next-value logic\nState case decode + transition-condition muxes\nCounter incrementers (+1) and zero/hold muxes\nk/l/q nested carry and reset selection\nactive_q inversion in ADVANCE\ndone next = CLEAR_TILE && !has_next", fillcolor="#fff1cf"];
 decode [label="Control and handshake decode\nload_enable / load_macro\ninput/kernel ready and FIFO pushes\nweight_load / first_load / feature_load\nCOMPE, FCSN, RCSN, WCSN, WEN\nFA / RA / WA selection\nacc_clear / busy / ready / result_valid", fillcolor="#fff1cf"];
 }
 subgraph cluster_regs {
 label="Clocked register banks (RTL flip-flops)"; color="#598cc0";
 states [label="State registers\nstate_q: 3 bits\ncompute_state_q: 2 bits", fillcolor="#dbeafe"];
 job [label="Job registers\nk_size_q, l_size_q, q_size_q: 3 x 32\nmode_q: 2, sign_q: 2, bias_q: 32\nmask_q: 256, compute_mask_q: 10", fillcolor="#dbeafe"];
 indices [label="Position / status registers\nk_q, l_q, q_q: 3 x 32\nactive_q: 1, done_o: 1", fillcolor="#dbeafe"];
 counts [label="Progress registers\nweights_received_q / weights_loaded_q: 8 each\ninputs_received_q: 6, first_sections_q: 3\nvector_q: 3, section_q: 2, row_q: 5\nresults_q: 9", fillcolor="#dbeafe"];
 }
 pins [label="Cleopatra control pins\nStream ready / push\nJob status + output tile handshake"];
 ext -> cond;
 ext -> update [label="config capture / handshake inputs"];
 cond -> update [label="transition / update conditions"];
 cond -> decode;
 update -> states [label="D"];
 update -> job [label="D: capture when accepted start; otherwise hold"];
 update -> indices [label="D"];
 update -> counts [label="D"];
 states -> cond [label="Q feedback", constraint=false];
 job -> cond [label="Q feedback", constraint=false];
 indices -> cond [label="Q feedback", constraint=false];
 counts -> cond [label="Q feedback", constraint=false];
 states -> update [label="current state / hold", constraint=false];
 counts -> update [label="increment / hold", constraint=false];
 indices -> update [label="advance / hold", constraint=false];
 states -> decode;
 counts -> decode;
 indices -> decode;
 decode -> pins;
 job -> pins [label="latched configuration"];
 indices -> pins [label="done_o and result k/q"];
 note [shape=note, fillcolor="#f1f5f9", label="Every register clocks on rising clk_i.\nAsynchronous active-low reset: core_rst_n.\nThe RTL writes next values inside always_ff;\nthere are no explicit *_d signals. Muxes/adders\nhere show the hardware implied by those writes.\nExact cells / state encoding depend on synthesis."];

}
